<%= form_for([@user, @connection], builder: RzFormBuilder, html: { class: 'rz-form rz-form--card' }) do |f| %>
  <%= render partial: "/shared/errors", locals: { f_object: @connection } %>
  <%= f.text_field :name, label: t("connections.views.add.name") %>
  <%= f.email_field :email, label: t("connections.views.add.email") %>
  <div class="rz-form__actions actions">
    <%= f.submit t("connections.actions.save.button"), class: 'save' %>
  </div>
<% end %>
