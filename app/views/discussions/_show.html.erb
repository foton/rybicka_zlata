<section id="discussion" class="rz-section rz-discussion">
  <h4 class="rz-section__title"><%= t('discussion.header') %></h4>
  <ul id="posts" class="rz-discussion__posts">
    <%= render partial: 'discussions/post', collection: @discussion_service.posts %>
  </ul>
  <div id="post_form">
    <%= render partial: 'discussions/form' %>
  </div>
</section>
