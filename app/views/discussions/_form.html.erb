<% if @discussion_service.can_add_post? %>
  <% post = @discussion_service.build_post %>
  <%= form_for(post, url: discussions_posts_path, builder: RzFormBuilder, html: { class: 'rz-form rz-form--wide' }) do |f| %>
    <%= f.hidden_field :wish_id %>
    <%= f.text_area :content, label: false, rows: 4,
                              placeholder: t("discussion.post_placeholder.#{@discussion_service.user_role}",
                                             show_to_donees_label: t('discussion.show_to_donees_label')) %>
    <% unless @discussion_service.forced_visibility_for_posts? %>
      <%= f.check_box :show_to_anybody, label: t('discussion.show_to_donees_label') %>
    <% end %>
    <div class="rz-form__actions actions">
      <%= f.submit t("discussion.add_post.button"), class: 'save' %>
    </div>
  <% end %>
<% end %>
