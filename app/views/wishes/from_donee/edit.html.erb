<h3><%= @wish.title %></h3>
<p><%= @wish.description %></p>

<%= form_for(@wish, url: user_my_wish_path(current_user, @wish), builder: RzFormBuilder,
                    html: { class: 'rz-form rz-form--wide' }) do |f| %>
  <%= render partial: "/shared/errors", locals: { f_object: @wish } %>

  <%= render ConnectionPickerComponent.new(
        mode: :toggle, connections: @available_donor_connections, groups: @available_donor_groups,
        field_name: 'wish[donor_conn_ids]', selected_ids: @wish.donor_connections.map(&:id),
        toggle_label: t('rybickazlata.connection_picker.roles.donor')) %>

  <div class="rz-form__actions actions">
    <%= f.submit t("wishes.actions.save.button"), class: 'save' %>
  </div>
<% end %>
