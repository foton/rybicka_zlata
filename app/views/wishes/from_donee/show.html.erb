<div id="donee_wish_show">
  <h3 class="rz-page-title"><%= @wish.title %></h3>
  <p class="rz-wish-detail__description"><%= raw to_html(@wish.description) %></p>

  <div class="actions rz-button-row">
    <% (@wish.available_actions_for(@user) - [:show]).each do |action| %>
      <%= render ObjectActionComponent.new(action: action, user: @user, object: @wish, params: { state_action: action }) %>
    <% end %>
    <%= render ObjectActionComponent.new(action: :another_new, user: @user, object: Wish::FromAuthor.new, variant: :outlined) %>
  </div>

  <div class="rz-card-grid" id="wish_connections">
    <section class="donees rz-card" id="donee_connections">
      <h4 class="rz-card__title"><%= t("wishes.donees.header") %></h4>
      <ul class="connection_list rz-card__list">
        <% @wish.donee_connections.each do |conn| %>
          <li><%= conn.fullname %></li>
        <% end %>
      </ul>
    </section>

    <section class="donors rz-card" id="donor_connections">
      <h4 class="rz-card__title"><%= t("wishes.donors.header") %></h4>
      <p class="rz-card__subtitle">
        <%= t("wishes.from_donee.views.show.donors.count", total: @wish.donor_connections.count,
                                                          owns: @wish.donor_connections.owned_by(current_user).count) %>
      </p>
      <ul class="connection_list rz-card__list">
        <% @wish.donor_connections.owned_by(current_user).each do |conn| %>
          <li><%= conn.fullname %></li>
        <% end %>
      </ul>
    </section>
  </div>

  <%= render partial: 'discussions/show' %>
</div>
