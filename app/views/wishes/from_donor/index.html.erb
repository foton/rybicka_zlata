<h3 class="rz-page-title"><%= t("wishes.from_donor.views.index.header") %></h3>

<nav id="donees_list" class="lists rz-chips rz-chips--nav" aria-label="<%= t('wishes.donees.header') %>">
  <ul>
    <%= render(partial: "donee_shortcut", collection: @wishes_by_donees.donees, as: 'donee') %>
  </ul>
</nav>

<div id="wishes">
  <div id="donor_wishes_list" class="lists">
    <%= render(partial: "donee_wishes", collection: @wishes_by_donees.all) ||
          tag.p(t("wishes.from_donor.views.index.no_wishes"), class: 'rz-list__empty') %>
  </div>
</div>
