<section id="<%= donee_wishes[:user].anchor %>" class="lists wishes-list rz-section">
  <h4 class="rz-section__title">
    <%= donee_wishes[:user].displayed_name_for(@user) %>
    <span class="rz-section__subtitle">[<%= donee_wishes[:user].displayed_name %>]</span>
  </h4>
  <%= render(partial: "/shared/list_with_actions",
             locals: { collection: donee_wishes[:wishes], none_text: t("wishes.from_donor.views.list.none"), remote: true }) %>
</section>
