<div id="donor_wish_show">
  <h3 id="title" class="rz-page-title"><%= @wish.title %></h3>
  <p id="description" class="rz-wish-detail__description"><%= raw to_html(@wish.description) %></p>

  <section id="donees" class="rz-card">
    <h4 class="rz-card__title"><%= I18n.t("wishes.from_donor.views.show.donees_list_header") %></h4>
    <ul id="donees_list" class="rz-card__list">
      <% @wish.donee_names_for(@user).each do |donee_name| %>
        <li><%= donee_name %></li>
      <% end %>
    </ul>
  </section>

  <div class="actions rz-button-row">
    <% (@wish.available_actions_for(@user) - [:show]).each do |action| %>
      <%= render ObjectActionComponent.new(action: action, user: @user, object: @wish, params: { state_action: action }) %>
    <% end %>
  </div>

  <%= render partial: 'discussions/show' %>
</div>
