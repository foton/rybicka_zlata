<%= form_for(@wish, as: :wish, url: url, builder: RzFormBuilder, html: { class: 'rz-form rz-form--wide' }) do |f| %>
  <%= render partial: "/shared/errors", locals: { f_object: @wish } %>
  <%= f.text_field :title, label: (@wish.persisted? ? t("wishes.from_author.views.edit.title") : t("wishes.from_author.views.new.title")) %>
  <%= f.text_area :description, label: t("wishes.from_author.views.edit.description"), rows: 6 %>

  <%= render ConnectionPickerComponent.new(
        connections: @user_connections, groups: @user_groups, field_name: 'wish[connection_roles]',
        roles: @wish.donee_connections.to_h { |c| [c.id, :donee] }
                    .merge(@wish.donor_connections.to_h { |c| [c.id, :donor] })) %>

  <div class="rz-form__actions actions">
    <%= f.submit t("wishes.actions.save.button"), class: 'save' %>
  </div>
<% end %>
