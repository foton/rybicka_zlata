<%= link_to path_to_wish_action_for_user(:show, @user, object), name: anchor_for(object), class: 'rz-wish' do %>
  <span class="title rz-wish__title">
    <%= icon_of_wish_sharing(object) %>
    <span class="rz-wish__title-text"><%= object.title %></span>
  </span>
  <%= donor_infos_for(object) %>
  <span class="description rz-wish__description"><%= raw to_html(object.description_shortened) %></span>
  <span class="info rz-wish__meta" id="<%= anchor_for(object) %>_updated_by_donee_at"
        title="<%= I18n.t('activerecord.attributes.wish.updated_by_donee_at') %>">
    <%= I18n.l(object.updated_by_donee_at || object.created_at) %>
  </span>
<% end %>
