<h2><%= t('.change_your_password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             builder: RzFormBuilder, html: { method: :put, class: 'rz-form' }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <%= render 'devise/shared/new_password_fields', f: f,
             password_label: t('.new_password'), confirmation_label: t('.confirm_new_password') %>

  <div class="rz-form__actions">
    <%= f.submit t('.change_my_password') %>
  </div>
<% end %>
