<h3 class="rz-page-title"><%= t('.forgot_your_password') %></h3>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             builder: RzFormBuilder, html: { method: :post, class: 'rz-form' }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%= f.email_field :email, autofocus: true, autocomplete: 'email' %>

  <div class="rz-form__actions">
    <%= f.submit t('.send_me_reset_password_instructions') %>
  </div>
<% end %>
