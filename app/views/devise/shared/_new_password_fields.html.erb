<%# locals: f, required (false), password_label (nil = attribute name), confirmation_label (nil) %>
<% required = local_assigns.fetch(:required, false) %>
<% if @minimum_password_length %>
  <%= f.password_field :password, label: local_assigns[:password_label], autocomplete: 'new-password',
                                  required: required, pattern: ".{#{@minimum_password_length},}",
                                  supporting_text: t('devise.passwords.minimum_length', min: @minimum_password_length) %>
<% else %>
  <%= f.password_field :password, label: local_assigns[:password_label], autocomplete: 'new-password',
                                  required: required %>
<% end %>
<%= f.password_field :password_confirmation, label: local_assigns[:confirmation_label],
                                             autocomplete: 'new-password', required: required %>
