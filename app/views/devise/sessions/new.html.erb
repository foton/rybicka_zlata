<% set_page_title(t("devise.sessions.new.sign_in") ) -%>

<div class="mdl-grid">

  <div class="mdl-cell" >
    <div id="omniauth_links">
      <div><%= t("devise.shared.links.sign_in_with_provider", provider: "") %></div>
      <%= render partial: "devise/shared/omniauth_links" %>
    </div>
  </div>

  <div class="mdl-cell divider-h" >
  </div>

  <div class="mdl-cell mdl-cell--1-col vh-centered" >
    <div><%= t("or") %></div>
  </div>

  <div class="mdl-cell divider-h" >
  </div>

  <div class="mdl-cell">
  <%# Devise's message (wrong e-mail/password, "you must sign in", ...) is shown here at the form,
      not in the snackbar; after a failed attempt (POST) the fields are marked invalid too %>
  <% sign_in_alert = flash[:alert].tap { flash.delete(:alert) } %>
  <% sign_in_failed = sign_in_alert.present? && request.post? %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
               builder: RzFormBuilder, html: { class: 'rz-form' }) do |f| %>
    <% if sign_in_alert.present? %>
      <div id="sign_in_alert" class="rz-form-errors <%= 'rz-form-errors--info' unless sign_in_failed %>" role="alert">
        <%= sign_in_alert %>
      </div>
    <% end %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', error: sign_in_failed %>
    <%= f.password_field :password, autocomplete: 'current-password', error: sign_in_failed %>

    <% if devise_mapping.rememberable? -%>
      <%= f.switch :remember_me %>
    <% end -%>

    <div class="rz-form__actions">
      <%= f.submit t('devise.sessions.new.sign_in') %>
    </div>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to t("devise.shared.links.forgot_your_password"), new_password_path(resource_name) %><br />
  <% end -%>

  </div>

</div>


