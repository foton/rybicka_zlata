<%= set_page_title(t("devise.registrations.edit.title", resource: "profil")) %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 builder: RzFormBuilder, html: { method: :put, class: 'rz-form' }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.text_field :name, autofocus: true %>
      <%= f.email_field :email, required: true, autocomplete: 'email' %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p><%= t("devise.registrations.waiting_for_confirmation", email: resource.unconfirmed_email) %></p>
      <% end %>

      <%= render 'devise/shared/new_password_fields', f: f %>
      <%= f.password_field :current_password, autocomplete: 'current-password', required: true,
                                              supporting_text: t('devise.passwords.current_password_reason') %>
      <%= f.select :locale, RybickaZlata4::Application.available_locales %>
      <%= f.time_zone_select :time_zone %>

      <%= render(partial: '/users/infos_form', locals: { f: f }) %>

      <div class="rz-form__actions">
        <%= f.submit t('devise.registrations.edit.update') %>
      </div>
    <% end %>

    <div id="delete_registration">
      <div class="rz-button-row">
        <%= t('.unhappy', :default => 'Unhappy') %>?
        <%= button_link_to(I18n.t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name),
              {
                method: :delete,
                class: "delete",
                data: {
                  confirm: t("devise.registrations.delete.confirm.message"),
                  #keys are with '-', for consistency
                  #if underscore is used 'confirm_yes', still dashed 'data-confirm-yes = "YES"' is generated in html
                  "confirm-yes": t("confirm.yes"),
                  "confirm_no": t("confirm.no")
                }
              }
            ) %>
      </div>
    </div>

