<%= set_page_title(t("devise.sign_up")) %>

<div class="mdl-grid">

  <div class="mdl-cell" >
    <div id="omniauth_links">
      <div><%= t("devise.shared.links.sign_in_with_provider", provider: "") %></div>
      <%= render partial: "devise/shared/omniauth_links" %>
    </div>
  </div>

  <div class="mdl-cell divider-h" >
  </div>

  <div class="mdl-cell mdl-cell--1-col vh-centered" >
    <div><%= t("or") %></div>
  </div>

  <div class="mdl-cell divider-h" >
  </div>

  <div class="mdl-cell">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 builder: RzFormBuilder, html: { class: 'rz-form' }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.text_field :name, autofocus: true %>
      <%= f.email_field :email, required: true, autocomplete: 'email' %>
      <%= render 'devise/shared/new_password_fields', f: f, required: true %>
      <%= f.select :locale, RybickaZlata4::Application.available_locales %>
      <%= f.time_zone_select :time_zone %>

      <div class="rz-form__actions">
        <%= f.submit t('devise.registrations.new.sign_up') %>
      </div>
    <% end %>
  </div>

</div>
