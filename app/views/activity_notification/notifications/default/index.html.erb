<div class="notification_wrapper">
  <h3 class="rz-page-title"><%= t('notification.views.index.header', target_name: @target.printable_target_name) %></h3>

  <% if @target.has_unopened_notifications? %>
    <div class="rz-button-row">
      <%= render ButtonComponent.new(t('notification.views.index.open_all'), variant: :tonal, icon: 'done_all',
                                     href: open_all_notifications_path_for(@target, @index_options.slice(:routing_scope, :devise_default_routes)),
                                     method: :post, class: 'open_all') %>
    </div>
  <% end %>

  <% if @notifications.present? %>
    <ul class="notifications rz-notifications">
      <%= render_notification @notifications,
                              @index_options.slice(:routing_scope, :devise_default_routes)
                                            .merge(fallback: @index_options[:with_group_members] ? :default_without_grouping : :default,
                                                   with_group_members: @index_options[:with_group_members]) %>
    </ul>
  <% else %>
    <p class="rz-list__empty"><%= t('notification.views.index.none') %></p>
  <% end %>
</div>
