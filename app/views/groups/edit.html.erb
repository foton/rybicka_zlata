<div id="edit_group">
  <%= form_for([@user, @group], builder: RzFormBuilder, html: { class: 'rz-form rz-form--wide' }) do |f| %>
    <%= render partial: "/shared/errors", locals: { f_object: @group } %>
    <%= f.text_field :name, label: t("groups.views.add.name") %>

    <%= render ConnectionPickerComponent.new(
          mode: :toggle, connections: @user_connections, field_name: 'group[connection_ids]',
          selected_ids: @group.connections.map(&:id), include_hidden: true, id: 'group_connections') %>

    <div class="rz-form__actions actions">
      <%= f.submit t("groups.actions.save.button"), class: 'save' %>
    </div>
  <% end %>
</div>
