<h3><%= t("groups.views.header") %></h3>

<p class="help mdl-cell--12-col"><%= raw to_html(t("groups.views.help")) %></p>

<div id="groups">
 	<div id="add_group" class="form-add">
	  <%= form_for([@user, @group], builder: RzFormBuilder, html: { class: 'rz-form rz-form--card' }) do |f| %>
      <%= render partial: "/shared/errors", locals: { f_object: @group } %>
      <%= f.text_field :name, label: t("groups.views.add.name") %>
      <div class="rz-form__actions actions">
        <%= f.submit t("groups.actions.new.next_button"), class: 'next-step' %>
      </div>
		<% end %>
		<%= add_new_button(I18n.t("groups.actions.new.button"))  if @group.errors.empty?%>
	</div>


  <div id="groups_list" class="list">
	  <%= render( partial: "/shared/list_with_actions", locals: { collection: @user.groups, none_text: t("groups.views.list.none"), remote: false} ) %>
	</div>
</div>       
       
