<!DOCTYPE html>
<%# data-theme="light": dark mode is built (see m3/color.css) but stays off until the
    inner pages are migrated from MDL, whose components have hard-coded light colors.
    Remove the attribute to follow the OS setting. %>
<html lang="<%= I18n.locale %>" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("rybickazlata.name") -%>: <%= content_for?(:title) ? yield(:title) : t("rybickazlata.title") -%></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=block">

  <%# Legacy UI (inner pages until they are migrated): Material Design Lite + Material Icons %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/material-design-lite/1.3.0/material.indigo-amber.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/material-design-lite/1.3.0/material.min.js"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

  <%= stylesheet_link_tag    'm3', media: 'all' %>
  <%= stylesheet_link_tag    'application', media: 'all' %>
  <%= javascript_include_tag 'application' %>
  <%= javascript_importmap_tags 'rz' %>

  <%= yield :javascripts %>
  <%= yield :stylesheets %>

  <%= csrf_meta_tags %>
</head>
<body class="rz">
  <a class="rz-skip-link" href="#main"><%= t('rybickazlata.layout.skip_to_content') %></a>

  <%= render Layout::TopAppBarComponent.new(user: current_user,
                                            unopened_notifications_count: unopened_notifications_count) %>

  <div class="rz-shell <%= 'rz-shell--with-nav' if user_signed_in? %>">
    <% if user_signed_in? %>
      <%= render Layout::NavDrawerComponent.new(user: current_user, current_path: request.path,
                                                unopened_notifications_count: unopened_notifications_count) %>
    <% end %>

    <main class="rz-main" id="main">
      <section class="rz-main__content">
        <%= yield %>
      </section>
      <%= render Layout::FooterComponent.new %>
    </main>
  </div>

  <%= render SnackbarComponent.new(flash: flash) %>
</body>
</html>
