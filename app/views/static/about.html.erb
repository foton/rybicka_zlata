<h2><%= t("rybickazlata.static.about.title") %></h2>
<h2><%= t("rybickazlata.static.contact_us.title") %></h2>
<%= form_for(@message, as: :message, url: message_to_admin_url, method: :post,
             builder: RzFormBuilder, html: { class: 'rz-form rz-form--wide' }) do |f| %>
  <%= f.text_area :body, label: t("rybickazlata.static.contact_us.message.to_admin.body_title"), rows: 10 %>
  <%= f.email_field :reply_to, label: t("rybickazlata.static.contact_us.message.to_admin.reply_to_title") %>
  <div class="rz-form__actions">
    <%= f.submit t("rybickazlata.static.contact_us.message.to_admin.send_button"), class: 'send' %>
  </div>
<% end %>
