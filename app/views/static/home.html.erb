<div class="rz-home">
  <% unless user_signed_in? %>
    <div class="rz-button-row rz-home__actions">
      <%= render ButtonComponent.new(t("devise.sessions.new.sign_in"), href: new_user_session_path) %>
      <%= render ButtonComponent.new(t("devise.registrations.new.sign_up"), href: new_user_registration_path,
                                     variant: :tonal) %>
    </div>
  <% end %>

  <div class="rz-home__intro">
    <div id="wishes_links_image" class="rz-home__image">
      <%= image_tag("wishes_links_optimized.svg", alt: "") %>
    </div>
    <div class="home rz-home__article">
      <%= render partial: "home_article" %>
    </div>
  </div>

  <div id="videoframe" class="rz-home__video">
    <div class="video_responsive_frame">
      <iframe id="video_tutorial" src="https://www.youtube.com/embed/qH6ZwUEs-Es" title="Rybička zlatá"
              allowfullscreen loading="lazy"></iframe>
    </div>
  </div>
</div>
