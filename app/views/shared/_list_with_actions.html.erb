<%# locals: collection, none_text, remote (true = row actions answered by Turbo Streams) %>
<%= render ListComponent.new(empty_text: none_text) do |list| %>
  <% collection.each do |object| %>
    <% list.with_item(object: object, user: @user, remote: remote) do %>
      <%= render partial: "list_item_primary_content", locals: { object: object } %>
    <% end %>
  <% end %>
<% end %>
